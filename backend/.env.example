# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Max accepted upload size in megabytes
MAX_UPLOAD_MB=500

# Directory used to store videos while they are being processed
TMP_UPLOAD_DIR=tmp_uploads

# Uvicorn bind settings (used by `python main.py`, ignored by Cloud Run/gunicorn)
HOST=0.0.0.0
PORT=8000

# Log level: debug | info | warning | error
LOG_LEVEL=info

# Path to the coaching LLM's GGUF weights (see scripts/download_coaching_model.py).
# Left at the default and unfetched, coaching feedback falls back to plain
# templated sentences — the pipeline works either way.
# COACHING_MODEL_PATH=models/coaching_llm.gguf

# Optional Firestore/Cloud Storage persistence (app/services/storage.py).
# Leave both unset to keep jump results ephemeral (today's behavior).
# GCP_PROJECT_ID=your-gcp-project-id
# STORAGE_BUCKET_NAME=your-bucket-name
